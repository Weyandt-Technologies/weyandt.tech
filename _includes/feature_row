{%- comment -%}
  Local fork of minimal-mistakes 4.24.0 _includes/feature_row.

  Only change: the item title's heading level is a parameter, `title_tag`, which
  defaults to the theme's h2. Rows that sit under an h2 section heading ("Who I
  work with", "What the role covers") pass title_tag="h3" so the cards nest under
  their section in the outline instead of appearing as its siblings. Styling keys
  on .archive__item-title, so nothing in _custom.scss depends on the tag.

  `remote_theme` is pinned to an exact tag, so this fork will not silently drift.
  If that pin is ever bumped, re-diff this file against the new tag.
{%- endcomment -%}
{% if include.id %}
  {% assign feature_row = page[include.id] %}
{% else %}
  {% assign feature_row = page.feature_row %}
{% endif %}
{% assign title_tag = include.title_tag | default: "h2" %}

<div class="feature__wrapper">

  {% for f in feature_row %}
    <div class="feature__item{% if include.type %}--{{ include.type }}{% endif %}">
      <div class="archive__item">
        {% if f.image_path %}
          <div class="archive__item-teaser">
            <img src="{{ f.image_path | relative_url }}"
                 alt="{% if f.alt %}{{ f.alt }}{% endif %}">
            {% if f.image_caption %}
              <span class="archive__item-caption">{{ f.image_caption | markdownify | remove: "<p>" | remove: "</p>" }}</span>
            {% endif %}
          </div>
        {% endif %}

        <div class="archive__item-body">
          {% if f.title %}
            <{{ title_tag }} class="archive__item-title">{{ f.title }}</{{ title_tag }}>
          {% endif %}

          {% if f.excerpt %}
            <div class="archive__item-excerpt">
              {{ f.excerpt | markdownify }}
            </div>
          {% endif %}

          {% if f.url %}
            <p><a href="{{ f.url | relative_url }}" class="btn {{ f.btn_class }}">{{ f.btn_label | default: site.data.ui-text[site.locale].more_label | default: "Learn More" }}</a></p>
          {% endif %}
        </div>
      </div>
    </div>
  {% endfor %}

</div>
